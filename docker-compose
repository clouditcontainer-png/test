services:
  backend:
    build: ./backend
    ports:
      - "8080:8080"
    volumes:
      - ./runtime/data:/app/data
      - ./runtime/license-storage:/app/license-storage
      - ./runtime/keys:/app/keys
  frontend:
    build: ./frontend
    environment:
      NEXT_PUBLIC_API_URL: http://localhost:8080
    ports:
      - "3000:3000"
    depends_on:
      - backend
