:root{--blue:#1457d9;--navy:#0b1633;--bg:#f4f7fb;--text:#182036;--muted:#68728a;--line:#e2e8f0}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}button,input{font:inherit}button{border:0;border-radius:8px;background:var(--blue);color:white;padding:10px 16px;font-weight:700;cursor:pointer}button.secondary{background:white;color:var(--navy)}header{background:var(--navy);color:white;padding:14px 5%;display:flex;align-items:center;justify-content:space-between}header b{font-size:19px}header span{margin-left:12px;color:#a9b8dc}.user{display:flex;align-items:center;gap:14px}.container{width:min(1200px,92%);margin:28px auto}.hero h1{margin-bottom:5px}.hero p{color:var(--muted)}.card{background:white;border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:0 5px 18px #10224b0c;margin:20px 0}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:14px}.stat{background:white;border:1px solid var(--line);padding:18px;border-radius:13px}.stat span{display:block;color:var(--muted);text-transform:capitalize}.stat strong{display:block;font-size:30px;margin-top:7px}.loginPage{min-height:100vh;display:grid;place-items:center;background:linear-gradient(135deg,#07152f,#1457d9)}.login{width:min(430px,92%)}.brand{height:48px;width:48px;border-radius:12px;background:var(--blue);color:white;display:grid;place-items:center;font-weight:900}.login label,.create label{display:grid;gap:7px;margin:14px 0;color:var(--muted);text-transform:capitalize}.login input,.create input,.toolbar input{padding:12px;border:1px solid var(--line);border-radius:8px}.login button{width:100%;margin:8px 0}.login small,.login p{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:0 16px}summary{font-weight:800;cursor:pointer}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px}.toolbar input{width:min(430px,100%)}.tableWrap{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:13px 10px;border-bottom:1px solid var(--line);white-space:nowrap}th{color:var(--muted);font-size:13px}.actions{display:flex;gap:6px}.small{padding:6px 9px;font-size:12px;background:#eaf0ff;color:#164db1}.warn{background:#fff3cd;color:#775d00}.danger{background:#ffe5e5;color:#a71919}.pill{padding:5px 9px;border-radius:99px;background:#e9eef8;font-size:12px;font-weight:800}.pill.active{background:#daf5e7;color:#17653a}.pill.suspended{background:#fff1cc;color:#785b00}.pill.revoked,.pill.expired{background:#ffe2e2;color:#9c1d1d}.error{background:#ffe8e8;color:#971d1d;padding:12px;border-radius:8px;margin:12px 0}.empty{text-align:center;color:var(--muted);padding:25px}@media(max-width:700px){header,.toolbar{align-items:flex-start;flex-direction:column}.user{width:100%;justify-content:space-between}.actions{flex-wrap:wrap}}
